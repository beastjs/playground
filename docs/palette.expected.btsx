// COMMAND PALETTE
import { useCallback, useMemo, useRef, useState } from "octane";
module
  interface Command {
    id: string;
    title: string;
    group: string;
    shortcut?: string;
    disabled?: boolean;
  }
props { commands, recent, onRun }: { commands: Command[]; recent: string[]; onRun: (id: string) => void }
setup
  const [query, setQuery] = useState("");
  const [cursor, setCursor] = useState(0);
  const inputRef = useRef<HTMLInputElement>(null);
  const matches = useMemo(() => commands.filter((command) => command.title.toLowerCase().includes(query.toLowerCase())), [commands, query]);
  const groups = useMemo(() => [...new Set(matches.map((command) => command.group))], [matches]);

  const run = useCallback((command: Command) => {
    if (command.disabled)
      return;
    onRun(command.id);
  }, [onRun]);
#palette(
  ~ className="fixed inset-0 z-50 grid place-items-start p-4"
  ~ role="dialog"
  ~ aria-modal="true"
  ~ aria-labelledby="palette-label"
  ~ )
  div(className="w-full max-w-xl rounded-sm bg-neutral-900 text-neutral-100")
    label#palette-label.sr-only Run a command
    input(
      ~ className="w-full bg-transparent px-5 py-4 text-base outline-none"
      ~ ref={inputRef}
      ~ type="search"
      ~ value={query}
      ~ placeholder="Type a command..."
      ~ autoFocus
      ~ aria-controls="palette-results"
      ~ onInput={(event) => setQuery(event.currentTarget.value)}
      ~ )
    #palette-results(className="max-h-80 overflow-auto py-2" role="listbox")
      each group in groups key group
        section.py-1
          h2(className="p-2 font-bold uppercase text-neutral-500") #{group}
          each command, index in matches.filter((command) => command.group === group) key command.id
            button(
              ~ type="button"
              ~ role="option"
              ~ aria-selected={index === cursor}
              ~ aria-disabled={command.disabled}
              ~ onClick={() => run(command)}
              ~ onMouseEnter={() => setCursor(index)}
              ~ className={index === cursor ? "grid place-items-center gap-4 bg-white/10 p-2" : "p-5 text-neutral-300"}
              ~ )
              span #{command.title}
              if command.shortcut
                kbd(className="rounded border border-white/15 p-1") #{command.shortcut}
      if matches.length === 0
        p(className="px-5 py-8 text-center text-sm text-neutral-500") No commands match "#{query}"
    footer(className="flex items-center justify-between p-3 text-neutral-500")
      span #{matches.length} of #{commands.length}
      span Recent: #{recent.length}
