{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beast-converter",
  "compatibility_date": "2026-09-24",
  // Static-only deploy: rspack builds the SPA into `dist/` and Workers serves it
  // as assets. Unknown paths fall back to index.html for client-side routing.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
