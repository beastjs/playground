{
  "name": "beast-converter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve --mode development",
    "build": "rspack build --mode production",
    "preview": "rspack serve --mode production",
    "typecheck": "tsrx-tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run validate && bun run build",
    "test": "bun test",
    "validate": "bun run scripts/validate.ts",
    "validate:types": "bun run scripts/validate.ts --types",
    "cf:dev": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@octanejs/base-ui": "^0.1.55",
    "@octanejs/radix": "^0.1.55",
    "@octanejs/resizable-panels": "^0.0.13",
    "@octanejs/vaul": "^0.0.22",
    "beast-tsrx": "0.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "octane": "0.4.3",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@octanejs/rspack-plugin": "0.1.52",
    "@rspack/cli": "^2.2.7",
    "@rspack/core": "^2.2.7",
    "@rspack/dev-server": "^2.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsrx/typescript-plugin": "0.4.8",
    "@types/node": "^26.6.2",
    "postcss-loader": "^8.2.1",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.137.0"
  }
}
