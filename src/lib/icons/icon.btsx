import { type IconNameType, icons } from './icons'
import type { IconProps as BaseIconProps } from './types'
import { cn } from '../utils'

props { name, className, size, color, solid, onClick, svgStyle }: BaseIconProps

setup
  const icon = icons[name as IconNameType]
  const s = size ?? 20
  const c = color ?? 'currentColor'
  const isSolid = solid ?? true
  const viewBox = String(icon?.viewBox ?? '0 0 24 24')
  const symbol = icon?.symbol ?? ''

div(className={cn(onClick && 'cursor-pointer active:scale-92 transition-transform duration-200','flex items-center justify-center m-0.75', className)} onClick={onClick})
  svg(aria-hidden={true} strokeWidth="1" className={cn('shrink-0 my-auto', onClick && 'cursor-pointer', className, svgStyle)} xmlns="http://www.w3.org/2000/svg" viewBox={viewBox} width={s} height={s} fill={isSolid ? c : 'none'} stroke={isSolid ? 'none' : c} strokeLinejoin="round" strokeLinecap="round" dangerouslySetInnerHTML={{ __html: symbol }} onClick={onClick})
