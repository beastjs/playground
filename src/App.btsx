import { useState, useEffect, useMemo } from 'octane'
import { convertTsx } from '@/lib/tsx-btsx.ts'
import { SAMPLES } from '@/samples'
import { measure, formatReduction } from '@/lib/metrics'
import { compileToTsrx, type TsrxResult } from '@/lib/tsrx'
import Header from './components/header.btsx'
import SamplePicker from './components/workspace/sample-picker.btsx'
import DesktopLayout from './components/workspace/desktop-layout.btsx'
import MobileCarousel from './components/workspace/mobile-carousel.btsx'
import PanelToggles from './components/workspace/panel-toggles.btsx'
import type { PanelId, PanelSide, PanelVisibility, Result, WorkspacePanels } from './components/workspace/types'

module
  const DESKTOP_QUERY = '(min-width: 1024px)'

props {}: {}
setup
  const [sourceId, setSourceId] = useState<string>(SAMPLES[0].id);
  const [source, setSource] = useState<string>(SAMPLES[0].tsx);
  const [copiedSide, setCopiedSide] = useState<PanelSide | null>(null);
  const [pasteBlocked, setPasteBlocked] = useState<boolean>(false);
  const [isDesktop, setIsDesktop] = useState<boolean>(true);
  const [visible, setVisible] = useState<PanelVisibility>({ tsx: true, btsx: true, tsrx: true });
  // The whole pipeline is a function of the source alone. Everything else this
  // component tracks — copy feedback, paste feedback, the layout switching —
  // re-renders it, and recompiling on each of those runs Beast and Octane's
  // compilers several times per keystroke.
  const result = useMemo((): Result => {
    try {
      const { code, diagnostics } = convertTsx(source);
      return { ok: true, output: code, diagnostics };
    } catch (error) {
      return { ok: false, output: error instanceof Error ? error.message : String(error) };
    }
  }, [source]);
  // Both panels are measured the same way, so the two sets of counts compare.
  const tsxMetrics = useMemo(() => measure(source), [source]);
  const btsxMetrics = useMemo(() => measure(result.ok ? result.output : ''), [result]);
  const reduction = result.ok ? formatReduction(tsxMetrics.chars, btsxMetrics.chars) : null;
  // What Beast compiles the BTSX to, and whether Octane's compiler accepts it —
  // the parser alone lets through output that only fails at this stage.
  const tsrx = useMemo((): TsrxResult => result.ok
    ? compileToTsrx(result.output)
    : { ok: false, output: 'The TSX has to convert to BTSX before it can compile to TSRX.', octaneError: null }, [result]);
  const tsrxMetrics = useMemo(() => measure(tsrx.ok ? tsrx.output : ''), [tsrx]);
  // A conversion that compiles can still have dropped something on the way;
  // the converter says what, and the BTSX panel passes it on.
  const warnings = result.diagnostics ?? [];
  const conversionCheck = warnings.length > 0
    ? { ok: false, label: `${warnings.length} warning${warnings.length === 1 ? '' : 's'}`, detail: warnings.map((d) => `${d.line}:${d.column} ${d.message}`).join('\n') }
    : null;
  const octaneCheck = tsrx.ok
    ? { ok: tsrx.octaneError === null, label: tsrx.octaneError === null ? 'octane compiled ✓' : 'octane ✗', detail: tsrx.octaneError === null ? null : `Octane rejected this TSRX: ${tsrx.octaneError}` }
    : null;
  const selectSample = (id: string) => {
    const sample = SAMPLES.find((entry) => entry.id === id) ?? SAMPLES[0];
    setSourceId(sample.id);
    setSource(sample.tsx);
    setCopiedSide(null);
  };
  const edit = (event: Event) => {
    setSource((event.currentTarget as HTMLTextAreaElement).value);
    setSourceId('custom');
    setCopiedSide(null);
  };
  const copy = async (side: PanelSide, text: string) => { await navigator.clipboard.writeText(text); setCopiedSide(side); window.setTimeout(() => setCopiedSide(null), 1600); };
  // Replaces the whole source with the clipboard. Reading the clipboard needs
  // the user's permission, and a denied read rejects, so the button says so
  // instead of looking like it did nothing.
  const paste = async () => {
    try {
      const text = await navigator.clipboard.readText();
      setSource(text);
      setSourceId('custom');
      setCopiedSide(null);
      setPasteBlocked(false);
    } catch {
      setPasteBlocked(true);
      window.setTimeout(() => setPasteBlocked(false), 1600);
    }
  };
  const togglePanel = (id: PanelId) => {
    setVisible((current) => {
      const next = { ...current, [id]: !current[id] };
      return Object.values(next).some(Boolean) ? next : current;
    });
  };
  const panels: WorkspacePanels = {
    source: {
      source,
      metrics: tsxMetrics,
      copied: copiedSide === 'left',
      pasteBlocked,
      onCopy: () => copy('left', source),
      onPaste: paste,
      onEdit: edit
    },
    btsx: {
      eyebrow: 'beast',
      title: 'BTSX',
      lang: 'btsx',
      result,
      metrics: btsxMetrics,
      reduction,
      copied: copiedSide === 'right',
      onCopy: () => copy('right', result.output),
      check: conversionCheck
    },
    tsrx: {
      eyebrow: 'octane',
      title: 'TSRX',
      lang: 'tsrx',
      result: tsrx,
      metrics: tsrxMetrics,
      reduction: null,
      copied: copiedSide === 'tsrx',
      onCopy: () => copy('tsrx', tsrx.output),
      check: octaneCheck
    }
  };

setup
  useEffect(() => {
    const query = window.matchMedia(DESKTOP_QUERY);
    const update = () => setIsDesktop(query.matches);
    update();
    query.addEventListener('change', update);
    return () => query.removeEventListener('change', update);
  }, []);

main(className='grid min-h-screen min-w-[96vw] place-items-center')
  section(
    ~ aria-labelledby="showcase-title"
    ~ className='w-full overflow-hidden rounded-[1.75rem] border border-white/85 bg-white/75 px-4 py-4 shadow-[0_24px_55px_rgba(28,28,25,0.09)]'
    ~ )
    Header
      // Toggle Panel Visibility
      if isDesktop
        PanelToggles(visible={visible} onToggle={togglePanel})
      div(className='flex items-center gap-4')
        span(className='text-[#595956] font-medium') Examples
        div(className='flex items-center gap-2')

        SamplePicker(sourceId={sourceId} onSelect={selectSample})

    section#workflow-panel(
      ~ aria-live="polite"
      ~ className='flex-1 min-h-[90vh] h-full rounded-3xl bg-[#eeeeeb]/90 p-2 sm:rounded-[2rem]'
      ~ )
      if isDesktop
        DesktopLayout(panels={panels} visible={visible})
      else
        MobileCarousel(panels={panels})

  footer(className='pt-0')
