import { useState, useEffect, useRef } from 'octane'
import { Group, Panel, Separator } from '@octanejs/resizable-panels'
import { convertTsxToBtsx } from '@/lib/tsx-btsx.ts'
import { highlight } from '@/lib/shiki'
import { SAMPLES } from '@/samples'
import { measure, formatCount, formatReduction, type Metrics } from '@/lib/metrics'
import Avatar from '@/components/ui/avatar.btsx'

module
  type PanelSide = 'left' | 'right'
  export interface Result {
    ok: boolean
    output: string
  }
  const DESKTOP_QUERY = '(min-width: 1024px)'
  const SLIDE_COUNT = 2

component Stats
  props { metrics, reduction, tone }: { metrics: Metrics; reduction: string | null; tone: string }
  div(className={`flex flex-wrap items-baseline gap-x-1.5 text-[0.7rem] font-semibold tabular-nums ${tone}`})
    span #{formatCount(metrics.lines, 'line')}
    span(aria-hidden="true") ·
    span #{formatCount(metrics.tokens, 'token')}
    span(aria-hidden="true") ·
    span #{formatCount(metrics.chars, 'char')}
    if reduction !== null
      span(
        ~ title="Characters saved against the TSX source"
        ~ className='rounded-full bg-emerald-400/15 px-1.5 py-0.5 text-emerald-500'
        ~ )
        | #{reduction}

component SourcePanel
  props { source, html, metrics, copied, pasteBlocked, onCopy, onPaste, onEdit, onScrollSync }: { source: string; html: { __html: string }; metrics: Metrics; copied: boolean; pasteBlocked: boolean; onCopy: () => void; onPaste: () => void; onEdit: (event: Event) => void; onScrollSync: (event: Event) => void }
  article(className='flex h-full min-h-0 flex-col rounded-[1.15rem] p-4 sm:rounded-[1.45rem] sm:p-6')
    div(className='flex items-start justify-between gap-4')
      div(className='min-w-0')
        p(className='text-[0.72rem] font-bold uppercase tracking-[0.11em] text-[#9b9b96]') react
        div(className='flex flex-wrap items-baseline gap-x-3 gap-y-1')
          h2(className='text-[clamp(1.2rem,2.8vw,1.5rem)] font-medium leading-[1.16] tracking-[-0.035em] text-[#161616]') TSX
          Stats(metrics={metrics} reduction={null} tone='text-[#9b9b96]')
      div(className='flex shrink-0 items-center gap-2')
        button(
          ~ type="button"
          ~ onClick={onPaste}
          ~ className='shrink-0 cursor-pointer rounded-full border border-black/10 bg-white/70 px-2 py-1 text-xs font-semibold text-[#595956] transition hover:text-[#111] focus-visible:ring-3 focus-visible:ring-orange-200'
          ~ )
          | #{pasteBlocked ? 'Blocked' : 'Paste'}
        button(
          ~ type="button"
          ~ onClick={onCopy}
          ~ className='shrink-0 cursor-pointer rounded-full border border-black/10 bg-white/70 px-2 py-1 text-xs font-semibold text-[#595956] transition hover:text-[#111] focus-visible:ring-3 focus-visible:ring-orange-200'
          ~ )
          | #{copied ? 'Copied' : 'Copy'}
    div(className='code-surface relative mt-6 min-h-0 flex-1 overflow-hidden rounded-xl border border-black/8 bg-white/60 focus-within:ring-3 focus-within:ring-orange-200')
      div(
        ~ aria-hidden="true"
        ~ className='pointer-events-none absolute inset-0 overflow-hidden'
        ~ dangerouslySetInnerHTML={html}
        ~ )
      textarea(
        ~ aria-label="TSX source"
        ~ spellcheck={false}
        ~ value={source}
        ~ onInput={onEdit}
        ~ onScroll={onScrollSync}
        ~ className='absolute inset-0 h-full w-full resize-none overflow-auto bg-transparent text-transparent caret-[#161616] outline-none'
        ~ )

component OutputPanel
  props { result, html, metrics, reduction, copied, onCopy }: { result: Result; html: { __html: string }; metrics: Metrics; reduction: string | null; copied: boolean; onCopy: () => void }
  article(className='flex h-full min-h-0 flex-col rounded-[1.15rem] bg-[radial-gradient(circle_at_88%_10%,rgba(255,255,255,0.07),transparent_28rem),linear-gradient(145deg,#2a2b29,#111211_72%)] p-4 text-[#f6f6f2] shadow-[0_22px_36px_rgba(15,16,14,0.18)] sm:rounded-[1.45rem] sm:p-6 scrollbar-track-[#18181b] scrollbar-thumb-[#14141b] scrollbar-thin')
    div(className='flex items-start justify-between')
      div(className='min-w-0')
        p(className='text-[0.72rem] font-bold uppercase tracking-[0.11em] text-[#858681]') beast
        div(className='flex flex-wrap items-baseline gap-x-3 gap-y-1')
          h2(className='text-[clamp(1.2rem,2.8vw,1.5rem)] font-medium leading-[1.16] tracking-[-0.035em]') BTSX
          if result.ok
            Stats(metrics={metrics} reduction={reduction} tone='text-[#858681]')
      button(
        ~ type="button"
        ~ onClick={onCopy}
        ~ className='shrink-0 cursor-pointer rounded-full border border-white/15 bg-white/10 px-2 py-1 text-xs font-semibold text-[#d8d8d2] transition hover:text-white focus-visible:ring-3 focus-visible:ring-orange-200'
        ~ )
        | #{copied ? 'Copied' : 'Copy'}
    if result.ok
      div(
        ~ className='code-surface mt-6 min-h-0 flex-1 overflow-auto rounded-xl'
        ~ dangerouslySetInnerHTML={html}
        ~ )
    else
      pre(
        ~ role="alert"
        ~ className='mt-6 min-h-0 flex-1 overflow-auto whitespace-pre-wrap break-words rounded-xl bg-red-500/10 p-4 font-mono text-xs leading-relaxed text-red-300'
        ~ )
        | #{result.output}

props {}: {}
setup
  const [sourceId, setSourceId] = useState<string>(SAMPLES[0].id);
  const [source, setSource] = useState<string>(SAMPLES[0].tsx);
  const [copiedSide, setCopiedSide] = useState<PanelSide | null>(null);
  const [pasteBlocked, setPasteBlocked] = useState<boolean>(false);
  const [tsxHtml, setTsxHtml] = useState<{ __html: string }>({ __html: '' });
  const [btsxHtml, setBtsxHtml] = useState<{ __html: string }>({ __html: '' });
  const [isDesktop, setIsDesktop] = useState<boolean>(true);
  const [slide, setSlide] = useState<number>(0);
  const carouselRef = useRef<HTMLDivElement>(null);
  const convert = (tsx: string): Result => {
    try {
      return { ok: true, output: convertTsxToBtsx(tsx) };
    } catch (error) {
      return { ok: false, output: error instanceof Error ? error.message : String(error) };
    }
  };
  const result = convert(source);
  // Both panels are measured the same way, so the two sets of counts compare.
  const tsxMetrics = measure(source);
  const btsxMetrics = measure(result.ok ? result.output : '');
  const reduction = result.ok ? formatReduction(tsxMetrics.chars, btsxMetrics.chars) : null;
  const selectSample = (id: string) => {
    const sample = SAMPLES.find((entry) => entry.id === id) ?? SAMPLES[0];
    setSourceId(sample.id);
    setSource(sample.tsx);
    setCopiedSide(null);
  };
  const edit = (event: Event) => {
    setSource((event.currentTarget as HTMLTextAreaElement).value);
    setSourceId('custom');
    setCopiedSide(null);
  };
  const syncScroll = (event: Event) => {
    const area = event.currentTarget as HTMLTextAreaElement;
    const layer = area.previousElementSibling as HTMLElement | null;
    if (layer === null) return;
    layer.scrollTop = area.scrollTop;
    layer.scrollLeft = area.scrollLeft;
  };
  const copy = async (side: PanelSide, text: string) => { await navigator.clipboard.writeText(text); setCopiedSide(side); window.setTimeout(() => setCopiedSide(null), 1600); };
  // Replaces the whole source with the clipboard. Reading the clipboard needs
  // the user's permission, and a denied read rejects, so the button says so
  // instead of looking like it did nothing.
  const paste = async () => {
    try {
      const text = await navigator.clipboard.readText();
      setSource(text);
      setSourceId('custom');
      setCopiedSide(null);
      setPasteBlocked(false);
    } catch {
      setPasteBlocked(true);
      window.setTimeout(() => setPasteBlocked(false), 1600);
    }
  };
  const trackSlide = (event: Event) => {
    const track = event.currentTarget as HTMLElement;
    if (track.clientWidth === 0) return;
    setSlide(Math.round(track.scrollLeft / track.clientWidth));
  };
  const showSlide = (index: number) => {
    const track = carouselRef.current;
    if (track === null) return;
    track.scrollTo({ left: index * track.clientWidth, behavior: 'smooth' });
  };

setup
  // Touch and trackpads page the carousel natively; a mouse cannot drag a
  // horizontal scroller, so pointer events stand in for the missing gesture.
  // Mouse only — hijacking touch here would replace the browser's own axis
  // detection and break vertical scrolling inside a panel.
  const drag = useRef<{ pending: boolean; active: boolean; x: number; y: number; left: number }>({
    pending: false,
    active: false,
    x: 0,
    y: 0,
    left: 0
  });
  const DRAG_THRESHOLD = 6;
  const beginDrag = (event: PointerEvent) => {
    if (event.pointerType !== 'mouse' || event.button !== 0) return;
    // Let the caret, buttons and links keep their own press behaviour.
    const target = event.target as HTMLElement | null;
    if (target !== null && target.closest('textarea, button, input, select, a') !== null) return;
    const track = event.currentTarget as HTMLElement;
    drag.current = { pending: true, active: false, x: event.clientX, y: event.clientY, left: track.scrollLeft };
  };
  const moveDrag = (event: PointerEvent) => {
    const state = drag.current;
    if (!state.pending) return;
    const track = event.currentTarget as HTMLElement;
    const dx = event.clientX - state.x;
    if (!state.active) {
      // Wait for a clearly horizontal intent so a click or a text selection is
      // still possible inside the panel.
      if (Math.abs(dx) < DRAG_THRESHOLD || Math.abs(dx) <= Math.abs(event.clientY - state.y)) return;
      state.active = true;
      // Capture keeps the drag alive past the element's edge, but throws if the
      // pointer is already gone; the drag still works without it.
      try {
        track.setPointerCapture(event.pointerId);
      } catch {
        // ignore
      }
      track.dataset.dragging = 'true';
      track.style.scrollSnapType = 'none';
      track.style.scrollBehavior = 'auto';
    }
    event.preventDefault();
    track.scrollLeft = state.left - dx;
  };
  const endDrag = (event: PointerEvent) => {
    const state = drag.current;
    const track = event.currentTarget as HTMLElement;
    drag.current = { pending: false, active: false, x: 0, y: 0, left: 0 };
    if (!state.active) return;
    try {
      if (track.hasPointerCapture(event.pointerId)) track.releasePointerCapture(event.pointerId);
    } catch {
      // ignore
    }
    delete track.dataset.dragging;
    track.style.scrollSnapType = '';
    track.style.scrollBehavior = '';
    const width = track.clientWidth;
    if (width === 0) return;
    // A short flick still turns the page; anything less settles back.
    const moved = track.scrollLeft - state.left;
    const from = Math.round(state.left / width);
    const to = Math.abs(moved) > width * 0.2 ? (moved > 0 ? from + 1 : from - 1) : from;
    showSlide(Math.max(0, Math.min(SLIDE_COUNT - 1, to)));
  };

setup
  useEffect(() => {
    const query = window.matchMedia(DESKTOP_QUERY);
    const update = () => setIsDesktop(query.matches);
    update();
    query.addEventListener('change', update);
    return () => query.removeEventListener('change', update);
  }, []);

setup
  useEffect(() => {
    let alive = true;
    highlight(source, 'tsx', 'github-light').then((html) => { if (alive) setTsxHtml({ __html: html }); });
    return () => { alive = false; };
  }, [source]);

setup
  useEffect(() => {
    if (!result.ok) return;
    let alive = true;
    highlight(result.output, 'btsx', 'github-dark').then((html) => { if (alive) setBtsxHtml({ __html: html }); });
    return () => { alive = false; };
  }, [result.ok, result.output]);

main(className='grid min-h-screen min-w-[96vw] place-items-center')
  section(
    ~ aria-labelledby="showcase-title"
    ~ className='w-full overflow-hidden rounded-[1.75rem] border border-white/85 bg-white/75 px-4 py-4 shadow-[0_24px_55px_rgba(28,28,25,0.09)] backdrop-blur-xl sm:rounded-[2.8rem]'
    ~ )
    header(className='flex flex-col items-start justify-between gap-6 px-1 py-2 md:flex-row md:items-center md:gap-8 md:px-3')
      Avatar(src='https://github.com/phtn.png')
      h1#showcase-title(className='m-0 max-w-xl text-[clamp(1rem,3.3vw,1.2rem)] font-medium leading-[1.08] tracking-[-0.045em] text-[#161616]')
        div(className='flex items-center text-[#161616]')
          p(className='ml-3 opacity-50 text-slate-400')  &rarr;
            span(className=' text-slate-500') BTSX

      nav(className='inline-flex w-full shrink-0 items-center rounded-full md:w-auto' aria-label="Sample sources" role="tablist")
        each sample in SAMPLES
          button(
            ~ type="button"
            ~ id={`tab-${sample.id}`}
            ~ role="tab"
            ~ aria-selected={sourceId === sample.id}
            ~ className={sourceId === sample.id ? 'inline-flex min-w-0 flex-1 cursor-pointer items-center justify-center gap-2 rounded-full border-0 bg-white/95 px-2.5 py-2 text-xs font-semibold text-[#242422] shadow-[0_1px_4px_rgba(26,26,24,0.14)] outline-none transition focus-visible:ring-3 focus-visible:ring-orange-200 sm:px-2 sm:text-sm md:min-w-32'
              ~ : 'inline-flex min-w-0 flex-1 cursor-pointer items-center justify-center gap-2 rounded-full border-0 bg-transparent px-2.5 py-3 text-xs font-semibold text-[#595956] outline-none transition hover:text-[#111] focus-visible:ring-3 focus-visible:ring-orange-200 sm:px-2 sm:text-sm md:min-w-32'}
            ~ onClick={() => selectSample(sample.id)}
            ~ )
            | #{sample.label}

    section#workflow-panel(
      ~ role="tabpanel"
      ~ aria-live="polite"
      ~ className='h-[84vh] rounded-3xl bg-[#eeeeeb]/90 p-2 sm:rounded-[2rem] sm:p-4'
      ~ )
      if isDesktop
        Group(
          ~ className='h-full w-full'
          ~ orientation="horizontal"
          ~ defaultLayout={{ tsx: 50, btsx: 50 }}
          ~ )
          Panel(id="tsx" minSize="22%")
            SourcePanel(
              ~ source={source}
              ~ html={tsxHtml}
              ~ metrics={tsxMetrics}
              ~ copied={copiedSide === 'left'}
              ~ pasteBlocked={pasteBlocked}
              ~ onCopy={() => copy('left', source)}
              ~ onPaste={paste}
              ~ onEdit={edit}
              ~ onScrollSync={syncScroll}
              ~ )
          Separator(className='panel-separator' aria-label="Resize panels")
          Panel(id="btsx" minSize="22%")
            OutputPanel(
              ~ result={result}
              ~ html={btsxHtml}
              ~ metrics={btsxMetrics}
              ~ reduction={reduction}
              ~ copied={copiedSide === 'right'}
              ~ onCopy={() => copy('right', result.output)}
              ~ )
      else
        div(className='flex h-full flex-col gap-2')
          div(
            ~ ref={carouselRef}
            ~ onScroll={trackSlide}
            ~ onPointerDown={beginDrag}
            ~ onPointerMove={moveDrag}
            ~ onPointerUp={endDrag}
            ~ onPointerCancel={endDrag}
            ~ className='panel-carousel min-h-0 flex-1'
            ~ )
            div(className='panel-slide')
              SourcePanel(
                ~ source={source}
                ~ html={tsxHtml}
                ~ metrics={tsxMetrics}
                ~ copied={copiedSide === 'left'}
                ~ pasteBlocked={pasteBlocked}
                ~ onCopy={() => copy('left', source)}
                ~ onPaste={paste}
                ~ onEdit={edit}
                ~ onScrollSync={syncScroll}
                ~ )
            div(className='panel-slide')
              OutputPanel(
                ~ result={result}
                ~ html={btsxHtml}
                ~ metrics={btsxMetrics}
                ~ reduction={reduction}
                ~ copied={copiedSide === 'right'}
                ~ onCopy={() => copy('right', result.output)}
                ~ )
          nav(className='flex shrink-0 items-center justify-center gap-2 py-1' aria-label="Panel")
            button(
              ~ type="button"
              ~ aria-label="Show TSX"
              ~ aria-current={slide === 0}
              ~ onClick={() => showSlide(0)}
              ~ className={slide === 0 ? 'h-2 w-6 cursor-pointer rounded-full border-0 bg-[#2a2b29] transition-all' : 'h-2 w-2 cursor-pointer rounded-full border-0 bg-black/20 transition-all'}
              ~ )
            button(
              ~ type="button"
              ~ aria-label="Show BTSX"
              ~ aria-current={slide === 1}
              ~ onClick={() => showSlide(1)}
              ~ className={slide === 1 ? 'h-2 w-6 cursor-pointer rounded-full border-0 bg-[#2a2b29] transition-all' : 'h-2 w-2 cursor-pointer rounded-full border-0 bg-black/20 transition-all'}
              ~ )

  footer(className='pt-0')
