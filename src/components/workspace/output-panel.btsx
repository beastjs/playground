import { useState, useEffect } from 'octane'
import { highlight } from '@/lib/shiki'
import { cn } from '@/lib/utils'
import { Icon } from '@/lib/icons'
import Stats from './stats.btsx'
import type { OutputPanelProps } from './types'

props { eyebrow, title, lang, result, metrics, reduction, copied, onCopy, check = null, className }: OutputPanelProps
setup
  const [html, setHtml] = useState<{ __html: string }>({ __html: '' });

setup
  useEffect(() => {
    if (!result.ok) return;
    let alive = true;
    highlight(result.output, lang, 'github-dark').then((next) => { if (alive) setHtml({ __html: next }); });
    return () => { alive = false; };
  }, [result.ok, result.output, lang]);

article(className={cn('flex h-full min-h-0 flex-col rounded-[1.15rem] p-4 sm:p-5 text-[#f6f6f2] sm:rounded-[1.45rem] scrollbar-track-transparent scrollbar-thumb-[#1f1f1f] scrollbar-thin overflow-hidden md:min-h-[88vh]', className)})
  div(className='flex items-start justify-between')
    div(className='min-w-0')
      p(className='text-[0.72rem] font-bold uppercase tracking-[0.11em] text-[#858681]') #{eyebrow}
      div(className='flex flex-wrap items-baseline gap-x-3 gap-y-1')
        h2(className='text-[clamp(1.2rem,2.8vw,1.5rem)] font-medium leading-[1.16] tracking-[-0.035em]') #{title}
        if result.ok
          Stats(metrics={metrics} reduction={reduction} tone='text-[#858681]')
        if check !== null
          span(
            ~ title={check.detail ?? undefined}
            ~ className={check.ok ? 'rounded-full bg-emerald-400/15 px-1.5 py-0.5 text-[0.7rem] font-semibold text-emerald-400' : 'rounded-full bg-amber-400/15 px-1.5 py-0.5 text-[0.7rem] font-semibold text-amber-300'}
            ~ )
            | #{check.label}
    button(
      ~ type="button"
      ~ onClick={onCopy}
      ~ className={cn('shrink-0 cursor-pointer rounded-lg text-xs font-semibold text-white/50 transition hover:text-white focus-visible:ring-3 focus-visible:ring-orange-200', {'text-white': copied})}
      ~ )
      Icon(name={copied ? 'copied' : 'copy'})
  if check !== null && check.detail !== null
    p(
      ~ role="status"
      ~ className='mt-4 whitespace-pre-line rounded-xl bg-amber-400/10 px-3 py-2 font-mono text-xs leading-relaxed text-amber-200'
      ~ )
      | #{check.detail}
  if result.ok
    div(
      ~ className='code-surface mt-6 min-h-0 flex-1 overflow-auto rounded-xl'
      ~ dangerouslySetInnerHTML={html}
      ~ )
  else
    pre(
      ~ role="alert"
      ~ className='mt-6 min-h-0 flex-1 overflow-auto whitespace-pre-wrap break-words rounded-xl bg-red-500/10 p-4 font-mono text-xs leading-relaxed text-red-300'
      ~ )
      | #{result.output}
