import type {OctaneNode} from 'octane'
import Avatar from "./ui/avatar.btsx";

props {children}:{children: OctaneNode}
setup
  const items = [
    { id: "home", label: "H", icon: 'new-folder' },
    { id: "search", label: "S", icon: 'search' },
    { id: "notifications", label: "N", icon: 'theme' },
    { id: "settings", label: "T", icon: 'settings' },
  ];
header(className='flex justify-between items-center px-1 py-2 md:px-3')
  div(className='flex items-center md:gap-4 gap-1')
    Avatar(src='https://github.com/beastjs.png' className='scale-80')
    h1(className='text-base font-bold skew-2') Beast
    span Converter


