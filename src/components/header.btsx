import type {OctaneNode} from 'octane/jsx-runtime'
import Avatar from "./ui/avatar.btsx";
import ButtonGroup from "./ui/button-group.btsx";
import TeamSwitcher from "./ui/team-switcher.btsx";

props {children}:{children: OctaneNode}
setup
  const items = [
    { id: "home", label: "H", icon: 'new-folder' },
    { id: "search", label: "S", icon: 'search' },
    { id: "notifications", label: "N", icon: 'theme' },
    { id: "settings", label: "T", icon: 'settings' },
  ];
header(className='flex flex-col items-start justify-between gap-6 px-1 py-2 md:flex-row md:items-center md:gap-8 md:px-3')
  div(className='flex items-center  gap-4')
    Avatar(src='https://github.com/beastjs.png')
    TeamSwitcher(teams={items})


    // FluidTooltip
    //   ButtonGroup
    //     each item in items
    //       FluidTooltipRoot(id={item.id})
    //         FluidTooltipTrigger(className='h-full w-10 text-slate-500 hover:bg-slate-200')
    //           | #{item.label}
    //         FluidTooltipContent(className='font-mono uppercase')
    //           | #{item.id}
  | #{children}
